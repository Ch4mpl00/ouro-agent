# Agent container env. Contains ONLY the LLM credential and model config —
# no integration secrets reach this container. Copy to .env.agent and fill.

# DeepSeek API key (https://platform.deepseek.com).
# No preset routes here by default any more (the `smart` preset moved to
# Gemini). Kept as an opt-in route: set AGENT_*_MODEL to a "deepseek-*" name
# and this key is what it uses. Still required at supervisor startup.
DEEPSEEK_API_KEY=""

# OpenAI API key (https://platform.openai.com).
# Used for recovery and simple non-thinking workers.
OPENAI_API_KEY=""

# Gemini API key (https://aistudio.google.com/apikey).
# Used by the primary AgentLoop and `smart` workers (gemini-3.7-flash:
# digests, semantic dedup, PDF parsing) via Gemini's OpenAI-compatible
# endpoint, and by the WORKFLOW COMPILER when AGENT_COMPILER_MODEL points at a
# "gemini-*" name. Required. A billing-enabled key is recommended; the free
# tier rate-limits hard (the Gemini provider retries 429/5xx, but the quota
# still has to allow it).
GEMINI_API_KEY=""

# OpenRouter API key (https://openrouter.ai/settings/keys). Required.
#   - typed decisions (crates/agent/src/decisions.rs) on TypeSafe's Jev —
#     the news digest's `decide` filter step runs on it.
#   - "openrouter/<vendor>/<model>" in any AGENT_*_MODEL override below, e.g.
#     AGENT_SMART_MODEL="openrouter/anthropic/claude-sonnet-5.5". Only that
#     explicit prefix routes here; bare "deepseek-*"/"gemini-*" stay direct.
OPEN_ROUTER_API_KEY=""

# Optional: the typed-decision model (OpenRouter id, no "openrouter/" prefix).
# "~typesafe/jev-latest" floats to the newest Jev.
# AGENT_DECISION_MODEL="typesafe/jev-1.13"
# Optional: decision endpoint override (e.g. a local integration-test service).
# OPENROUTER_DECISIONS_URL="https://openrouter.ai/api/alpha/decisions"

# Optional: override the `base` preset model (cheap non-thinking chat).
# Routed to OpenAI when the name starts with anything other than "deepseek".
# AGENT_BASE_MODEL="gpt-5.4-mini"

# Optional: override the `smart` preset model (thinking-mode sub-agents).
# Routing follows the name: "openrouter/*" → OpenRouter, "gemini-*" → Gemini,
# "deepseek-*" → DeepSeek, else → OpenAI. `deepseek-v4-pro` is the previous default and still a
# working fallback.
# AGENT_SMART_MODEL="gemini-3.7-flash"

# Optional: override the `smartest` preset model (reserve high-end preset for
# sub-agents / handoff). Strict structured-output is most reliable on OpenAI;
# keep this a non-"deepseek", non-"gemini" model.
# AGENT_SMARTEST_MODEL="gpt-5.4"

# Optional: override the `compiler` preset model (the workflow compiler).
# Routing follows the name: "gemini-*" → Gemini, "deepseek-*" → DeepSeek,
# else → OpenAI. gemini-3.5-flash (pricier, equally good) or gpt-5.4 are safe
# fallbacks if the preview model misbehaves.
# AGENT_COMPILER_MODEL="gemini-3-flash-preview"

# Langfuse observability (https://cloud.langfuse.com → Settings → API Keys).
# AgentLoop iterations, tools and workers use the same exporter as workflows.
# Leave these empty to disable remote export; the local trace mirror still runs.
# LANGFUSE_SECRET_KEY=""
# LANGFUSE_PUBLIC_KEY=""
# LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# Generic Codex service (docker-compose service name by default).
# The codex container persists auth in the codex-home volume; bootstrap once with:
#   docker compose run --rm codex codex login --device-auth
# CODEX_URL="http://codex:3010"

# Online judge worker. Defaults to Codex and dry-run score writes.
# Set JUDGE_WRITE_SCORES=true after confirming dry-run output.
# JUDGE_PROVIDER="codex"
# JUDGE_RECENT_LIMIT="20"
# JUDGE_POLL_INTERVAL_MS="60000"
# JUDGE_WRITE_SCORES="false"
# JUDGE_ONCE="false"
# CODEX_JUDGE_TIMEOUT_MS="600000"

# The note a scheduled fire carries (default chat, forum topics): the same
# values as TELEGRAM_DEFAULT_CHAT_ID / TELEGRAM_TOPICS_JSON in .env.mcp.
TELEGRAM_DEFAULT_CHAT_ID=""
# TELEGRAM_TOPICS_JSON='{"bills":42}'
