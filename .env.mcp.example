# MCP container env. Holds ALL integration credentials — the agent container
# never sees these. Copy to .env.mcp and fill in.

# Where to store downloaded Gmail attachments inside the container.
# Mounted from named volume mcp-storage. Default is fine.
STORAGE_DIR=/app/storage

# --- Gmail (Google Cloud OAuth client, Desktop app type) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost"
# Optional: pin to a specific Gmail account; otherwise the most-recently
# authorized one in integration_account is used.
# GMAIL_ACCOUNT_KEY=""

# --- Telegram bot (BotFather) ---
TELEGRAM_ASSISTANT_BOT_TOKEN=""
TELEGRAM_DEFAULT_CHAT_ID=""
# Optional: forum topics map (name → thread_id) injected into agent prompts.
# TELEGRAM_TOPICS_JSON='{"bills":42}'

# --- Telegram userbot (gramjs / MTProto) ---
# From https://my.telegram.org → API development tools.
# Run `userbot-auth` once inside the mcp container (or before deploy)
# to do the phone + code login; the session string is stored in mcp_state.
TELEGRAM_APP_ID=""
TELEGRAM_APP_API_HASH=""

# --- Monobank personal token ---
MONOBANK_API_KEY=""

# --- Postgres (news + pgvector). docker-compose builds DATABASE_URL from
# .env.postgres; uncomment to override (e.g. running mcp outside docker).
# DATABASE_URL="postgres://mcp:mcp@localhost:5432/mcp"

# --- OpenAI (used only for embeddings: text-embedding-3-small). ---
OPENAI_API_KEY=""

# --- MCP gateway: third-party MCP servers aggregated behind own-MCP. ---
# Upstreams are declared in crates/mcp/gateway.config.json (git-tracked);
# their secrets live here and are referenced as ${VAR} in that file. An
# upstream whose secret is unset is skipped at boot (logged), so the gateway
# stays inert until a key is provided — no behaviour change without one.
# Optional: point at a different gateway config file.
# GATEWAY_CONFIG="/app/crates/mcp/gateway.config.json"

# Tavily (https://app.tavily.com) — web_search / extract for the agent.
# Referenced by gateway.config.json as ${TAVILY_API_KEY}.
TAVILY_API_KEY=""

# --- OpenAI Secure MCP Tunnel (the `tunnel-client` compose service). ---
# Only needed if you run the ChatGPT connector; the rest of the stack
# ignores these. Create the tunnel in OpenAI Platform → tunnel settings
# (needs an API key with Tunnels Read + Manage — not the one below).
#
# docker-compose.yml maps these onto the daemon's own CONTROL_PLANE_*
# names in the tunnel-client entrypoint; that is the only place the
# mapping lives.

# tunnel_<32 hex chars>, from Platform tunnel settings.
OPENAI_TUNNEL_ID=""
# Runtime key for the daemon. SHOULD be a restricted key with Tunnels
# "Read" + "Use" only — never an admin/all-access key, this process runs
# unattended. Deliberately separate from OPENAI_API_KEY above: the daemon
# falls back to OPENAI_API_KEY when its own key is missing, and we do not
# want the embeddings credential authenticating the tunnel by accident.
OPENAI_TUNNEL_API_KEY=""

# Daily digest hours are no longer env-driven — they live as rows in the
# `scheduled_tasks` table (seeded on first boot). Change times via
# Telegram ("сделай дайджест в 8:00") or by editing the row directly.
